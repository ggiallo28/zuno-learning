{
    "name": "zuno-learning-app",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "Zuno:// - Personalized learning platform with AI coaching",
    "keywords": [
        "learning",
        "education",
        "ai-coaching",
        "personalized",
        "zuno"
    ],
    "scripts": {
        "dev": "vite --port 8080 --host",
        "build": "tsc --noEmit && vite build",
        "build:clean": "pkill -f esbuild || true && rm -rf .vite dist node_modules/.vite && bun run build",
        "build:analyze": "bun run build && bun run analyze",
        "build:production": "NODE_ENV=production bun run build",
        "build:validate": "bun run build && bun scripts/validate-build.js",
        "prepare:deployment": "bun scripts/prepare-deployment.js",
        "analyze": "bun scripts/analyze-bundle.js",
        "validate": "bun scripts/validate-build.js",
        "preview": "vite preview --port 4173 --host",
        "preview:production": "bun run build:production && bun run preview",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "bun run lint --fix",
        "start": "bun run dev",
        "test": "vitest",
        "test:run": "vitest run",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest --watch",
        "test:unit": "vitest run --run src",
        "test:integration": "vitest run --run src/contexts src/hooks",
        "test:components": "vitest run --run src/components",
        "test:utils": "vitest run --run src/utils",
        "test:actions": "vitest run --run src/actions",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:tasks": "vitest run tests/tasks/**/*.test.ts",
        "test:all": "bun run test:unit && bun run test:e2e && bun run test:tasks",
        "amplify:init": "amplify init",
        "amplify:push": "amplify push",
        "amplify:pull": "amplify pull",
        "amplify:status": "amplify status",
        "amplify:mock": "amplify mock",
        "amplify:publish": "amplify publish",
        "amplify:configure": "amplify configure",
        "deploy:cdn": "./scripts/deploy-cdn-aware.sh",
        "deploy:test": "node scripts/test-deployment.js"
    },
    "dependencies": {
        "@aws-amplify/ui-react": "^6.11.2",
        "@hookform/resolvers": "^5.2.1",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-alert-dialog": "^1.1.15",
        "@radix-ui/react-aspect-ratio": "^1.1.7",
        "@radix-ui/react-avatar": "^1.1.10",
        "@radix-ui/react-checkbox": "^1.3.2",
        "@radix-ui/react-collapsible": "^1.1.12",
        "@radix-ui/react-context-menu": "^2.2.16",
        "@radix-ui/react-dialog": "^1.1.14",
        "@radix-ui/react-hover-card": "^1.1.15",
        "@radix-ui/react-icons": "1.3.0",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-menubar": "^1.1.16",
        "@radix-ui/react-navigation-menu": "^1.2.14",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-progress": "^1.1.7",
        "@radix-ui/react-radio-group": "^1.3.7",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-select": "^2.2.5",
        "@radix-ui/react-separator": "^1.1.7",
        "@radix-ui/react-slider": "^1.3.5",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.12",
        "@radix-ui/react-toast": "^1.2.15",
        "@radix-ui/react-toggle": "^1.1.10",
        "@radix-ui/react-toggle-group": "^1.1.11",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@uibakery/data": "0.0.6",
        "aws-amplify": "^6.15.5",
        "canvas-confetti": "^1.9.3",
        "class-variance-authority": "0.7.0",
        "clsx": "2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.1.0",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.4.2",
        "jspdf": "^3.0.2",
        "jspdf-autotable": "^5.0.2",
        "lucide-react": "0.446.0",
        "next-themes": "^0.4.6",
        "react": "18.3.1",
        "react-day-picker": "^9.7.0",
        "react-dom": "18.3.1",
        "react-hook-form": "^7.62.0",
        "react-icons": "~5.5.0",
        "react-resizable-panels": "^3.0.4",
        "react-router-dom": "^7.8.0",
        "recharts": "^3.2.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "2.5.2",
        "vaul": "^1.1.2",
        "zod": "^4.0.15"
    },
    "devDependencies": {
        "@eslint/js": "9.11.1",
        "@faker-js/faker": "^9.9.0",
        "@playwright/test": "^1.54.2",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@testing-library/user-event": "^14.5.2",
        "@types/canvas-confetti": "^1.9.0",
        "@types/node": "22.7.3",
        "@types/react": "18.3.9",
        "@types/react-dom": "18.3.0",
        "@types/react-router-dom": "^5.3.3",
        "@vitejs/plugin-react": "^4.7.0",
        "@vitest/coverage-v8": "^2.1.8",
        "@vitest/ui": "^2.1.8",
        "autoprefixer": "10.4.20",
        "eslint": "9.11.1",
        "eslint-plugin-react-hooks": "5.1.0-rc.0",
        "eslint-plugin-react-refresh": "0.4.12",
        "fishery": "^2.3.1",
        "globals": "15.9.0",
        "jsdom": "^25.0.1",
        "msw": "^2.6.8",
        "playwright": "^1.49.1",
        "postcss": "8.4.47",
        "tailwindcss": "3.4.13",
        "tailwindcss-animate": "^1.0.7",
        "terser": "^5.43.1",
        "typescript": "5.5.3",
        "typescript-eslint": "8.7.0",
        "vite": "^7.0.6",
        "vitest": "^2.1.8"
    }
}