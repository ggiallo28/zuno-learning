enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CoachId {
  ELIA
  SKIPPY
  LUPA
  POLPO
}

enum ContentType {
  LESSON
  ASSESSMENT
  REVIEW
  CHALLENGE
}

enum CourseCategory {
  MATH
  SCIENCE
  LANGUAGE
  HISTORY
  TECHNOLOGY
  ART
  MUSIC
  BUSINESS
  HEALTH
  OTHER
}

enum CatalogItemType {
  COURSE
  LESSON
  QUIZ
  COACH
  ACHIEVEMENT
  ASSESSMENT
}

type Course {
  title: String
  category: CourseCategory
  difficultyLevel: DifficultyLevel
}

enum LessonType {
  VIDEO
  READING
  PRACTICE
  QUIZ
  DISCUSSION
  PROJECT
  ASSIGNMENT
  SUMMARY
  LIVE
  OTHER
}

type Lesson {
  courseId: ID
  title: String
  lessonOrder: Int
  lessonType: LessonType
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  FILL_IN_THE_BLANK
  MATCHING
  ORDERING
  ESSAY
  CODING
  IMAGE
  AUDIO
  VIDEO
  OTHER
}

type Quiz {
  courseId: ID
  lessonId: ID
  questionText: String
  questionType: QuestionType
}

type Coach {
  coachType: String
  displayName: String
  avatarUrl: String
  bio: String
}

enum RequirementType {
  COMPLETE_LESSON
  COMPLETE_COURSE
  PERFECT_SCORE
  DAILY_STREAK
  WEEKLY_STREAK
  MASTERY_LEVEL
  PARTICIPATION
  FIRST_LOGIN
  REFER_A_FRIEND
  CUSTOM
}

type Achievement {
  name: String
  requirementType: String
  xpReward: Int
  badgeIcon: String
}

enum CatalogResourceType {
  COURSE
  LESSON
  QUIZ
}

enum AssessmentGradingMode {
  AUTO
  MANUAL
  MIXED
}

type CatalogResourceItem {
  id: ID!
  type: CatalogResourceType!
}

type AssessmentTemplate {
  title: String!
  description: String
  difficulty: DifficultyLevel
  passingScore: Float
  totalScore: Float
  estimatedDuration: Int
  gradingMode: AssessmentGradingMode
  objectives: [String]
  randomizeQuestions: Boolean
  allowRetry: Boolean
  maxAttempts: Int

  resourceItems: [CatalogResourceItem!]
}

type ZunoCatalog @model {
  id: ID!
  parentId: ID @index(name: "byParent", sortKeyFields: ["itemType"])
  itemType: CatalogItemType! @index(name: "byItemType")

  course: Course
  quiz: Quiz 
  lesson: Lesson
  coach: Coach
  achievement: Achievement
  assessment: AssessmentTemplate

  facts: [ZunoEntry] @hasMany
}

type User {
  email: AWSEmail!
  username: String!
  fullName: String
  subscriptionTier: String
  totalXp: Int! 
  currentLevel: Int!
  coachType: String
  onboardingCompleted: Boolean!
}

type Progress {
  totalXpEarned: Int
  completedLessons: Int
  currentStreak: Int
  masteryLevel: String
}

type Activity {
  activityDate: AWSDate
  activityType: String
  description: String
}

type KnowledgeGap {
  subjectArea: String
  conceptName: String
  severity: String
}

type CoachInteraction {
  interactionType: String
  notes: String
  occurredAt: AWSDateTime
}

type Scheduled {
  contentId: ID
  nextReviewDate: AWSDate
  repetitionCount: Int
}

type LearningAnalytics {
  metricName: String
  metricValue: Float
  recordedAt: AWSDateTime
}

type AssessmentResult {
  score: Float
  passed: Boolean
}

enum GroupActivityType {
  SESSION
  DISCUSSION
  CHALLENGE
  VOTE
  ANNOUNCEMENT
  MEETING
  OTHER
}

type GroupActivityData {
  activityId: ID
  groupId: ID
  activityType: GroupActivityType
  title: String
  description: String
  startedAt: AWSDateTime
  endedAt: AWSDateTime
  participants: [ID]
}

type Metadata {
  user: User
  assessment: AssessmentResult
  progress: Progress
  activity: Activity
  knowledge: KnowledgeGap
  coachInteraction: CoachInteraction
  scheduled: Scheduled
  userLearningAnalytics: LearningAnalytics
  groupActivity: GroupActivityData 
}

enum ZunoEntryType {
  USER_PROGRESS
  ASSESSMENT_RESULT
  LESSON_COMPLETION
  QUIZ_ATTEMPT
  COURSE_COMPLETION
  GROUP_ACTIVITY
  REVIEW
  LEADERBOARD_ENTRY
  SESSION_LOG
  ACHIEVEMENT_UNLOCKED
  SCHEDULED_EVENT
  KNOWLEDGE_GAP
  COACH_INTERACTION
  LEARNING_ANALYTICS
  OTHER
}

type ZunoEntry @model {
  id: ID!
  
  userId: ID @index(name: "byUser", sortKeyFields: ["entryType", "timestamp"])
  entryType: ZunoEntryType 

  catalogId: ID
  catalog: ZunoCatalog @belongsTo(fields: ["catalogId"])

  groupId: ID
  group: ZunoGroup @belongsTo(fields: ["groupId"])

  
  timestamp: AWSDateTime
  metadata: Metadata
}


type ZunoGroup @model {
  id: ID!
  name: String
  subjectArea: String
  createdBy: ID
  members: [ID!]

  facts: [ZunoEntry] @hasMany
}