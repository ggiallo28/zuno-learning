#   isActive: Boolean
# 
#   currentSession: GroupSession
#   groupSettings: GroupSettings
# 
#   metadata: [Metadata] @hasMany(indexName: "byGroup", fields: ["id"])
# }

type GroupSettings {
  isPublic: Boolean
  allowChat: Boolean
  allowVoice: Boolean
}

type GroupSession {
  sessionId: String
  startTime: AWSDateTime
  participants: [String]
}

# ==== Metadata (Polymorphic Snapshot Store) ====

# type Metadata @model {
#   id: ID!
#   type: ZunoEntityType! @index(name: "byType")
#   parentType: ZunoParentType!
# 
#   userId: ID @index(name: "byUser", sortKeyFields: ["type"])
#   groupId: ID @index(name: "byGroup", sortKeyFields: ["type"])
#   contentId: ID @index(name: "byContent", sortKeyFields: ["type"])
# 
#   progress: ProgressData
#   assessmentData: AssessmentData
#   achievementData: AchievementData
#   sessionData: SessionData
#   repetition: SpacedRepetitionData
#   leaderboardData: GroupLeaderboardSnapshot
