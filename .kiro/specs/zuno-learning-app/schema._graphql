# ==== Leaderboard Snapshot ====

type GroupLeaderboardSnapshot {
  timeframe: LeaderboardTimeframe!
  entries: [LeaderboardEntry]
}

type LeaderboardEntry {
  userId: ID!
  score: Int
  rank: Int
  displayName: String
}

# ==== Embedded Types for Metadata ====

type ProgressData {
  currentLevel: Int
  experiencePoints: Int
  streakCurrent: Int
  streakLongest: Int
  lastLessonDate: AWSDate
  completedLessons: [String]
  masteredConcepts: [String]
  inProgressConcepts: [String]
  unknownConcepts: [String]
  confidenceScores: AWSJSON
  averageAccuracy: Float
  learningVelocity: Float
  retentionRate: Float
  engagementScore: Float
  difficultyProgression: [String]
  lastUpdated: AWSDateTime
}

type AssessmentData {
  assessmentType: AssessmentType
  completedAt: AWSDateTime
  results: AWSJSON
  knowledgeGaps: [String]
  recommendedFocus: [String]
}

type AchievementData {
  title: String
  description: String
  achievementType: String
  earnedAt: AWSDateTime
  badgeIcon: String
  coachId: CoachId
  triggerValue: Int
  achievementCategory: AchievementCategory
}

type SessionData {
  startTime: AWSDateTime
  endTime: AWSDateTime
  participants: AWSJSON
  activities: AWSJSON
  chatMessages: AWSJSON
}

type SpacedRepetitionData {
  nextReviewDate: AWSDate
  interval: Int
  easeFactor: Float
  repetitions: Int
  lastReviewDate: AWSDate
  performanceHistory: [Float]
}