# ==== Enums ====

enum ZunoEntityType {
  USER_PROGRESS
  ASSESSMENT
  REVIEW
  LEADERBOARD
  SESSION
  ACHIEVEMENT
}

enum ZunoParentType {
  USER
  GROUP
  CONTENT
}

enum CoachId {
  ELIA
  SKIPPY
  LUPA
  POLPO
}

enum AssessmentType {
  INITIAL
  PROGRESS
  FOCUS_CHECK
}

enum LeaderboardTimeframe {
  DAILY
  WEEKLY
  MONTHLY
  ALLTIME
}

enum AchievementCategory {
  STREAK
  MASTERY
  SOCIAL
  CONSISTENCY
}

enum ContentType {
  LESSON
  ASSESSMENT
  REVIEW
  CHALLENGE
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LearningObjectiveCategory {
  KNOWLEDGE
  COMPREHENSION
  APPLICATION
  ANALYSIS
  SYNTHESIS
  EVALUATION
}

enum MessagingTone {
  NEUTRAL
  FRIENDLY
  ENCOURAGING
  SERIOUS
}

enum InteractionStyle {
  TEXT
  VOICE
  INTERACTIVE
  VIDEO
}

# ==== Entry Point =====

type ZunoFact @model {
  id: ID!

  userId: ID @index(name: "byUser")
  groupId: ID @index(name: "byGroup")
  catalogId: ID @index(name: "byCatalog")
  # detailId: ID @index(name: "byDetail")

  metadata: AWSJSON
}

type ZunoGroup @model {
  id: ID!
  name: String!
  subjectArea: String
  createdBy: ID!
  members: [ID]
  courses: [ID]
  coaches: [ID]
  maxMembers: Int
  isActive: Boolean

  groupSettings: GroupSettings
  facts: [ZunoFact] @hasMany(indexName: "byUser", fields: ["id"])
}

type ZunoUser @model {
  id: ID!

  settings: UserSettings
  profile: UserProfileInfo
  preferences: UserPreferences
  privacySettings: PrivacySettings

  facts: [ZunoFact] @hasMany(indexName: "byGroup", fields: ["id"])
}

type ZunoCatalog @model {
  id: ID!
  title: String!
  category: String
  difficulty: DifficultyLevel
  coachId: CoachId

  contentData: ContentData
  coachDescription: CoachDescription

  facts: [ZunoFact] @hasMany(indexName: "byDetail", fields: ["id"])
}

# ==== User Profile ====

# type UserProfile @model {
#   id: ID!
# 
#   settings: UserSettings
#   profile: UserProfileInfo
#   preferences: UserPreferences
#   privacySettings: PrivacySettings
# 
#   groups: [LearningGroup] @hasMany(indexName: "byUser", fields: ["id"])
#   courses: [CourseContent] @hasMany(indexName: "byUser", fields: ["id"])
#   metadata: [Metadata] @hasMany(indexName: "byUser", fields: ["id"])
# }

type UserSettings {
  email: AWSEmail!
  username: String!
  fullName: String
  subscriptionTier: String
  coachType: CoachId
  onboardingCompleted: Boolean
}

type UserProfileInfo {
  displayName: String
  learningGoals: [String]
  preferredSubjects: [String]
  dailyLearningTime: Int
  timezone: String
  language: String
}

type UserPreferences {
  notificationSettings: AWSJSON
  gamificationLevel: String
  focusModeEnabled: Boolean
  offlineContentEnabled: Boolean
  personalizedMessaging: Boolean
}

type PrivacySettings {
  allowLeaderboard: Boolean
  allowGroupInvites: Boolean
  showActivityStatus: Boolean
}

# ==== Course Content ====

# type CourseContent @model {
#   id: ID!
#   title: String!
#   category: String
#   difficulty: DifficultyLevel
#   coachId: CoachId
# 
#   contentData: ContentData
#   coachDescription: CoachDescription
# 
#   metadata: [Metadata] @hasMany(indexName: "byContent", fields: ["id"])
# }

type ContentData {
  contentType: ContentType
  prerequisites: [String]
  learningObjectives: [LearningObjectiveCategory]
  estimatedDuration: Int
  coachAdaptations: AWSJSON
  interactiveElements: AWSJSON
  tags: [String]
  s3ContentUrl: AWSURL
}

type CoachDescription {
  name: String
  tone: MessagingTone
  interactionStyle: InteractionStyle
  bio: String
  avatarUrl: AWSURL
}

# ==== Learning Groups ====

# type LearningGroup @model {
#   id: ID!
#   name: String!
#   subjectArea: String
#   createdBy: ID!
#   members: [ID]
#   courses: [ID]
#   coaches: [ID]
