# Zuno Learning App Environment Variables

# Development/Production Mode
NODE_ENV=production

# Vite Environment Variables (must start with VITE_)
VITE_APP_NAME=Zuno
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION="Intelligenza Adattiva per l'Apprendimento Professionale"

# AWS Amplify Configuration (automatically handled by amplify)
# These are typically set by Amplify CLI and don't need manual configuration
# VITE_AWS_REGION=us-east-2
# VITE_AWS_USER_POOL_ID=
# VITE_AWS_USER_POOL_WEB_CLIENT_ID=
# VITE_AWS_APPSYNC_GRAPHQL_ENDPOINT=

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Debug Settings (development only)
VITE_DEBUG_MODE=false
VITE_SHOW_BUNDLE_ANALYZER=false

# API Configuration
VITE_API_TIMEOUT=30000
VITE_MAX_RETRY_ATTEMPTS=3

# UI Configuration
VITE_DEFAULT_THEME=light
VITE_ENABLE_ANIMATIONS=true
VITE_ENABLE_SOUND_EFFECTS=false